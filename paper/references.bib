@article{PSOFIC,
title = {Adaptive fractal image compression using PSO},
journal = {Procedia Computer Science},
volume = {2},
pages = {338-344},
year = {2010},
note = {Proceedings of the International Conference and Exhibition on Biometrics Technology},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2010.11.044},
url = {https://www.sciencedirect.com/science/article/pii/S1877050910003741},
author = {A. Muruganandham and R.S.D. {Wahida Banu}},
keywords = {Fractal image compression (FIC), Mean square error (MSE), Particle swarm optimization (PSO), Iteration function system (IFS)},
abstract = {At low bitrate and with acceptable quality in Fractal Image Compression (FIC) of the coded image, the encoding time is very large for most existing algorithms. In this paper, a fast fractal encoding system is proposed using particle swarm optimization (PSO) to reduce the encoding time. Here, an optimization technique is used for the MSE based on the stopping criterion between range block and domain block. This PSO technique can speedup the fractal encoder and preserve the image quality for medical imaging.}
}

